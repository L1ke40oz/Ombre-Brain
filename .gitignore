frontend/dashboard-new.html
frontend/dashboard-demo.html
test-dashboard-v3.bat
dashboard改写计划/

# 前端 Vue 工程（源码提交，依赖与构建产物不提交）
frontend/dashboard-src/node_modules/
frontend/dashboard-src/dist/

# frontend/app/ 是 ombre-brain-galaxy-mobile 的构建产物，故意「不」忽略：
# 1. Dockerfile 的 COPY frontend/ ./frontend/ 只带走构建上下文里的文件；
# 2. deploy/gen_update_manifest.py 只给 git 已跟踪的文件算哈希，未跟踪的
#    产物不会进热更新清单，Docker 用户永远收不到新前端。
# 所以每次改完前端要 build 一次并把产物一起提交。别在这里加 frontend/app/。
start_stdio.sh

# Ollama 模型权重 —— 体积大，不上传
ollama/

# 本地设计预览稿（非应用文件）
frontend/dashboard-preview.html

# Rust shadow-kernel build output. ombre-kernel is currently a library crate,
# so its generated Cargo.lock is not a release lockfile.
kernel/rust/**/target/
kernel/rust/ombre-kernel/Cargo.lock
.tmp/ombre-nodes-v2.yaml
.tmp/

# Local test protocols and generated smoke outputs — never publish.
tmp_pas_docs_*/
tmp_hnf1_pas_pair_smoke_*/

# Kilo Code 的工作目录，含它自己开的 git worktree（整份代码的副本）。
# git 本来就会跳过注册过的 worktree，ripgrep / ruff / pytest 实测也扫不到；
# 写在这里是为了覆盖将来任何遵守 gitignore 的工具，并把「这不是本仓库的代码」
# 这件事写明——按文件系统硬遍历的 grep -r / find 仍然会看到两份，
# 分析脚本得自己排除。
.kilo/

# 覆盖率产物（CI 每次重新生成）
coverage.xml
.coverage
htmlcov/
